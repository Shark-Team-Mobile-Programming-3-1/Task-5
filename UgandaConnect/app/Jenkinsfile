pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Explicitly telling Jenkins to use the 'main' branch
                git branch: 'main', url: 'https://github.com/Shark-Team-Mobile-Programming-3-1/Task-5.git'
            }
        }

        stage('Run JMeter Test') {
            steps {
                script {
                    // 1. Clean up previous results
                    bat 'if exist rapport-html rmdir /S /Q rapport-html'
                    bat 'if exist resultats.jtl del /F /Q resultats.jtl'

                    // 2. Run JMeter
                    // The path is relative to the workspace root
                    bat '"C:\\apache-jmeter-5.6.3\\bin\\jmeter.bat" -n -t UgandaConnect/UgandaConnect_Test.jmx -l resultats.jtl -e -o rapport-html'
                }
            }
        }

        stage('Publish Reports') {
            steps {
                // Publish the HTML report
                publishHTML(target: [
                    reportDir: 'rapport-html',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report (UgandaConnect)',
                    keepAll: true
                ])

                // Publish performance trends
                perfReport sourceDataFiles: 'resultats.jtl'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'resultats.jtl, jmeter.log, rapport-html/**',
                             fingerprint: true
        }
    }
}