pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Fetch the code (JMeter test plan, CSV files, etc.) from GitHub
                git 'https://github.com/Shark-Team-Mobile-Programming-3-1/Task-5.git'
            }
        }

        stage('Run JMeter Test') {
            steps {
                script {
                    // 1. Clean up previous results (Windows syntax)
                    // /S = includes subdirectories, /Q = quiet mode (no prompts)
                    bat 'if exist rapport-html rmdir /S /Q rapport-html'
                    bat 'if exist resultats.jtl del /F /Q resultats.jtl'

                    // 2. Run JMeter in non-GUI mode
                    // -n : non-GUI mode
                    // -t : test plan file (.jmx)
                    // -l : results file (.jtl)
                    // -e : generate HTML report after the test
                    // -o : output folder for the HTML report
                    bat '"C:\\apache-jmeter-5.6.3\\bin\\jmeter.bat" -n -t UgandaConnect_Test.jmx -l resultats.jtl -e -o rapport-html'
                }
            }
        }

        stage('Publish Reports') {
            steps {
                // A. Publish the HTML report generated by JMeter
                publishHTML(target: [
                    reportDir: 'rapport-html',
                    reportFiles: 'index.html',
                    reportName: 'JMeter HTML Report (UgandaConnect)',
                    keepAll: true
                ])

                // B. Publish results for the Performance Plugin (Trends)
                // This reads the .jtl file to generate graphs in Jenkins
                perfReport sourceDataFiles: 'resultats.jtl'
            }
        }
    }

    // Optional: Archive artifacts for debugging
    post {
        always {
            archiveArtifacts artifacts: 'resultats.jtl, jmeter.log, rapport-html/**',
                             fingerprint: true
        }
    }
}